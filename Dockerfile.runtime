FROM --platform=$BUILDPLATFORM node:24-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run check && npm run build

FROM --platform=$BUILDPLATFORM node:24-alpine AS mobile
WORKDIR /mobile
COPY mobile/package.json mobile/package-lock.json ./
RUN npm ci
COPY mobile/ ./
RUN npm run check && npm run build:pwa

FROM alpine:3.24

WORKDIR /app

# FFmpeg validates and converts audio; yt-dlp uses Deno for YouTube challenges.
RUN apk add --no-cache ca-certificates ffmpeg python3 py3-pip deno && \
    python3 -m venv /opt/yt-dlp && \
    /opt/yt-dlp/bin/pip install --no-cache-dir "yt-dlp[default]==2026.10.21" "bgutil-ytdlp-pot-provider==2.0.0"

ENV PATH="/opt/yt-dlp/bin:$PATH"

ENV WAVELENGTH_ADDR=0.0.0.0:8080 \
    WAVELENGTH_DATA_DIR=/data \
    WAVELENGTH_WEB_DIR=/web

COPY --from=web /web/dist /web
COPY --from=mobile /mobile/pwa-dist /web/app

EXPOSE 8080 8081
